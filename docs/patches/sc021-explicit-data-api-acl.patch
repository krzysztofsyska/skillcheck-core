diff --git a/db/prototypes/sc021-ai-gateway-ledger.sql b/db/prototypes/sc021-ai-gateway-ledger.sql
index 0a49019..c840b2b 100644
--- a/db/prototypes/sc021-ai-gateway-ledger.sql
+++ b/db/prototypes/sc021-ai-gateway-ledger.sql
@@ -55,6 +55,13 @@ create policy ai_gateway_limits_tenant_read on public.ai_gateway_limits
 create policy ai_gateway_usage_tenant_read on public.ai_gateway_usage
   for select to authenticated using (private.has_company_access(company_id));
 revoke all on public.ai_gateway_limits, public.ai_gateway_usage from public, anon, authenticated;
+-- SC-DB-API-001: the API client reads through authenticated RLS; workers use RPC.
+-- Do not retain service_role table access from historical Supabase defaults.
+do $$ begin
+  if exists (select 1 from pg_roles where rolname = 'service_role') then
+    revoke all on public.ai_gateway_limits, public.ai_gateway_usage from service_role;
+  end if;
+end $$;
 grant select on public.ai_gateway_limits, public.ai_gateway_usage to authenticated;
 -- Only the privileged database operator provisions budgets; company members cannot change limits.
 
diff --git a/tests/ai-gateway-data-api-acl.test.mjs b/tests/ai-gateway-data-api-acl.test.mjs
new file mode 100644
index 0000000..ee68ac0
--- /dev/null
+++ b/tests/ai-gateway-data-api-acl.test.mjs
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { PGlite } from '@electric-sql/pglite';
+
+const sql = await readFile(new URL('../db/prototypes/sc021-ai-gateway-ledger.sql', import.meta.url), 'utf8');
+for (const legacy of [false, true]) test(`SC-021 explicit table ACL / legacy=${legacy}`, async t => {
+  const db = new PGlite(); t.after(() => db.close());
+  const a='11111111-1111-4111-8111-111111111111', b='22222222-2222-4222-8222-222222222222';
+  await db.exec(`create role anon nologin; create role authenticated nologin;
+    create role screening_worker nologin; create role service_role nologin bypassrls;
+    create schema private; grant usage on schema private to authenticated;
+    create table public.companies(id uuid primary key);
+    create function private.has_company_access(target_company uuid) returns boolean language sql stable
+      as $$select current_setting('sc021.actor_company',true)=target_company::text$$;`);
+  if (legacy) await db.exec('alter default privileges in schema public grant all on tables to anon,authenticated,service_role');
+  await db.exec(sql);
+  await db.query('insert into public.companies values($1),($2)',[a,b]);
+  await db.query('insert into public.ai_gateway_limits(company_id,monthly_limit_micro_usd) values($1,100),($2,100)',[a,b]);
+  for (const table of ['ai_gateway_limits','ai_gateway_usage']) {
+    for (const role of ['anon','authenticated','service_role']) {
+      for (const privilege of ['SELECT','INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER','MAINTAIN']) {
+        const result=(await db.query('select has_table_privilege($1,$2,$3) as allowed',[role,`public.${table}`,privilege])).rows[0];
+        assert.equal(result.allowed,role==='authenticated'&&privilege==='SELECT',`${role}/${table}/${privilege}`);
+      }
+    }
+  }
+  await db.exec('set role authenticated');
+  await db.query("select set_config('sc021.actor_company',$1,false)",[a]);
+  assert.deepEqual((await db.query('select company_id from public.ai_gateway_limits')).rows,[{company_id:a}]);
+  await assert.rejects(db.query('update public.ai_gateway_limits set monthly_limit_micro_usd=1000'),e=>e.code==='42501');
+  await db.exec('reset role; set role service_role');
+  await assert.rejects(db.query('select * from public.ai_gateway_limits'),e=>e.code==='42501');
+  await db.exec('reset role; set role ai_meter_worker');
+  const result=await db.query(`select * from public.ai_gateway_reserve($1,gen_random_uuid(),gen_random_uuid(),null,null,
+    'cv_screening','openai','synthetic-model','revision-v1','policy-v1','price-v1',50)`,[a]);
+  assert.equal(result.rows[0].created,true);
+});
