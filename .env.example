# Public project settings only; never put a service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://wsvjawuikxfzjyivxgsu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On Vercel set this separately for Production; Preview uses system deployment URLs.
# Supabase redirect allowlist must match; see docs/auth-configuration.md.

# SC-005 server-only names. Never use NEXT_PUBLIC for these. Do not commit values.
# Vercel: SCREENING_AI_ENABLED, SCREENING_WORKER_DISPATCH_SECRET, SCREENING_WORKER_URL
# Supabase Edge Function secrets: OPENAI_API_KEY, SCREENING_WORKER_DISPATCH_SECRET, SUPABASE_DB_URL, SCREENING_AI_ENABLED
SCREENING_AI_ENABLED=false
SCREENING_WORKER_URL=

# SC-SALES-006C: server-only. Keep disabled until the release gates are met.
SALES_LEADS_ENABLED=false
SALES_LEAD_REQUEST_SECRET=
SALES_LEAD_NOTICE=

# SC-010 B1: reserved activation gates; no delivery implementation exists.
COMMUNICATION_ENABLED=false
COMMUNICATION_DELIVERY_ENABLED=false

# SC-019-MVP: server-only FREE/PRESELEKCJA UI gate. Keep OFF until the
# reviewed SQL migration is applied, tenant tests PASS, and owner approves release.
SC19_PACKAGES_ENABLED=false

# Read-only company catalog. Keep OFF until a separate catalog activation decision.
# Does not enable orders, add-ons or change checkout prices; packages gate also required.
SC19_CATALOG_ENABLED=false

# SC-PRICING internal calculator (/operator/pricing): server-only, comma-separated
# confirmed e-mails of pricing owners. Empty = nobody (fails closed), even for sales operators.
PRICING_OWNER_EMAILS=

# SC-014-C6: AI proposes the competency task, the recruiter approves it.
# Off means the recruiter writes the task by hand, exactly as today, and no model is called.
EXERCISE_AI_ENABLED=false

# SC-021-A2: route screening and exercise generation through the AI gateway (lib/ai-gateway).
# Off means both call OpenAI directly, exactly as before. Set in Vercel and in Supabase Edge
# Function secrets together; turning it on anywhere is a separate, reviewed step.
AI_GATEWAY_ENABLED=false

# SC-WER: Preview only after independent SQL/security review. No values committed.
COMPETENCY_CANDIDATE_PREVIEW=false
COMPETENCY_BROKER_ENABLED=false
COMPETENCY_BROKER_ORIGIN=
COMPETENCY_BROKER_CSRF_KEY=
COMPETENCY_BROKER_SOURCE_HMAC_KEY=
COMPETENCY_BROKER_GATEWAY_DATABASE_URL=
# postgres uses the existing Preview DB; redis requires a separately approved service.
COMPETENCY_BROKER_LIMITER=postgres
COMPETENCY_BROKER_LIMITER_REST_URL=
COMPETENCY_BROKER_LIMITER_REST_TOKEN=
