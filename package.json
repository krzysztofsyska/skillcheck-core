  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "next": "16.3.6",
    "pdf-parse": "2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "3.4.0"
