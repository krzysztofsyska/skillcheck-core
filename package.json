    "test:live": "node --env-file-if-exists=.env.local scripts/check-live-supabase.mjs",
    "test:cv": "node --test tests/cv.test.mjs tests/cv-database.test.mjs tests/cv-pdf.test.mjs tests/cv-docx.test.mjs",
    "test:pdf-bundle": "node scripts/check-pdf-bundle.mjs",
    "test:screening": "node --test tests/screening.test.mjs tests/screening-result-database.test.mjs tests/screening-hmac.test.mjs tests/screening-ai.test.mjs tests/screening-worker.test.mjs tests/screening-dispatch.test.mjs tests/screening-synthetic-fixture.test.mjs tests/screening-ui.test.mjs",
    "test:screening-concurrency": "node --test tests/screening-concurrency.test.mjs",
