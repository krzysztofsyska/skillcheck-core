    "test:behavior-guide": "node --test tests/behavior-guide.test.mjs",
    "test:behavior-assessments": "node --test tests/behavior-assessment.test.mjs tests/behavior-database.test.mjs",
    "test:agent-pipeline": "node --test tests/agent-pipeline/*.test.mjs",
    "agent:dry-run": "node tools/agent-pipeline/cli.mjs dry-run",
    "test:sales-leads-browser": "node tests/sales-leads-browser.cjs",
    "test:sales-leads-http": "node --test tests/sales-leads-http.test.mjs",
    "test:sales-leads": "node --test tests/sales-leads-database.test.mjs",
