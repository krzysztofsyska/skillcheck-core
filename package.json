    "test:screening-ranking-concurrency": "node --test tests/screening-ranking-concurrency.test.mjs",
    "test:screening-joint": "node --test tests/screening-joint-database.test.mjs",
    "test:communication": "node --test tests/candidate-communication-database.test.mjs",
    "test:communication-concurrency": "node --test tests/candidate-communication-concurrency.test.mjs"
