{
  "agent_name": "SkillCheck rozmowa wstępna v1",
  "version_description": "SkillCheck skillcheck-interview-v1: rozmowa wstępna FREE/PRESELEKCJA, firma i stanowisko z dynamicznych zmiennych.",
  "response_engine": {
    "type": "conversation-flow",
    "conversation_flow_id": "__CONVERSATION_FLOW_ID__",
