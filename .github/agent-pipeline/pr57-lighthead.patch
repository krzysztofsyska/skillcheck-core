+async function terminalProbeFixture() {
+  const f = feedbackFixture();
+  f.args.readHead = async () => f.snapshot.pull.head.sha;
+  f.args.cursor.getRun = async (_id, id) => ({ id, agentId: f.binding.agentId, status: 'FINISHED' });
